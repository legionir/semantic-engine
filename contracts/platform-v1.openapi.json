    "/api/v1/projects/{id}/search": {
      "post": {
        "summary": "Perform hybrid semantic and keyword search across codebase",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer",
                    "default": 20
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "hybrid",
                      "keyword",
                      "vector"
                    ]
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results with snippets and scores"
          }
        }
      }
    },
    "/api/v1/projects/{id}/symbols/{symbolId}": {
      "get": {
