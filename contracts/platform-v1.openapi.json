{
  "openapi": "3.1.0",
  "info": {
    "title": "Semantic Engine Platform Core API",
    "version": "1.0.0",
    "description": "REST and SSE API for Code Intelligence, Semantic LoD Visualization, Symbol Analysis, and Asynchronous Indexing."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000",
      "description": "Local Platform Core Server"
    }
  ],
  "paths": {
    "/api/v1/system": {
      "get": {
        "summary": "Get system information and engine capabilities",
        "responses": {
          "200": {
            "description": "System operational status and supported capabilities"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Platform health check",
        "responses": {
          "200": {
            "description": "Platform is healthy"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Platform readiness check",
        "responses": {
          "200": {
            "description": "Platform is ready to accept requests"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Platform memory and uptime metrics",
        "responses": {
          "200": {
            "description": "Memory and process runtime metrics"
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "summary": "Get current runtime platform configuration (secrets masked)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Configuration object"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "patch": {
        "summary": "Update runtime configuration (maxBodyBytes only; other keys are startup-only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "maxBodyBytes": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied to the running server; `persisted` is false"
          },
          "400": {
            "description": "Invalid value or unknown key"
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "Key can only change at startup (port, host, allowRemote, projectsRoot, token, staticDir, dataRoot)"
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "List all registered projects",
        "responses": {
          "200": {
            "description": "List of projects"
          }
        }
      },
      "post": {
        "summary": "Register a new project by workspace path",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project registered successfully"
          },
          "400": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/api/v1/projects/{id}": {
      "get": {
        "summary": "Get details of a specific project",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project details"
          },
          "404": {
            "description": "Project not found"
          }
        }
      },
      "patch": {
        "summary": "Update project name, enabled and autoStart",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "autoStart": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated and persisted"
          },
          "400": {
            "description": "Invalid field type"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Project not found"
          }
        }
      },
      "delete": {
        "summary": "Remove a project from the registry",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed from map and registry"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/v1/projects/{id}/index": {
      "post": {
        "summary": "Trigger asynchronous background indexing job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Indexing job queued and started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "projectId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "progress": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{id}/jobs/{jobId}": {
      "get": {
        "summary": "Get progress and status of an async job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status and progress record"
