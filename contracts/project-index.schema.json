    "aiMetadata": {
      "type": "object",
      "description": "خروجی فاز LLM-based (فاز جدا در build plan). فرمول امتیازها باید در docs/scoring.md مستند شود، نه فقط عدد خام.",
      "additionalProperties": false,
      "properties": {
