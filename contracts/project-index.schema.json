            "type": "string"
          }
        },
        "businessDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "designPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedFileIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimatedTokenCost": {
          "type": "integer",
          "minimum": 0
        },
        "aiScore": {
          "type": "object",
          "description": "همه‌ی امتیازهای مربوط به اولویت‌بندی خواندن، در یک آبجکت جمع شده (طبق پیشنهاد رفع همپوشانی importance/semanticWeight/...)",
